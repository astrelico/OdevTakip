<?xml version="1.0" encoding="utf-8"?>
<!--
  Günün listesi widget'ı (4 × 4) — en büyük kutu.

  Özet widget'ının genişletilmiş hâli: altı satır ve her satırın sağında
  kalan süre. Sağ sütun sabit genişliktedir, başlıkların alt alta
  dizilmesi ancak böyle bozulmaz.

  Satır kasaları `gone` başlar; kaç satır dolacağı koddan gelir. İlk
  açılışta (`initialLayout` ve `previewLayout`) yalnızca başlık, tarih ve
  "Bugün için ödev yok" görünür — sahte bir ödev listesi çizilmez.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/liste_kok"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_zemin"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/liste_baslik"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_liste_etiket"
            android:textColor="@color/widget_vurgu"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/liste_tarih"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/widget_ikincil"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/liste_ozet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/widget_bos"
        android:textColor="@color/widget_metin"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/liste_satir1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/liste_baslik1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_metin"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/liste_kalan1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:textColor="@color/widget_ikincil"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/liste_satir2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/liste_baslik2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_metin"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/liste_kalan2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:textColor="@color/widget_ikincil"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/liste_satir3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/liste_baslik3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_metin"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/liste_kalan3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:textColor="@color/widget_ikincil"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/liste_satir4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/liste_baslik4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_metin"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/liste_kalan4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:textColor="@color/widget_ikincil"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/liste_satir5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/liste_baslik5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_metin"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/liste_kalan5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:textColor="@color/widget_ikincil"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/liste_satir6"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/liste_baslik6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_metin"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/liste_kalan6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:textColor="@color/widget_ikincil"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/liste_daha"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/widget_ikincil"
        android:textSize="12sp"
        android:visibility="gone" />

</LinearLayout>
