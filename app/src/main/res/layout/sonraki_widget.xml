<?xml version="1.0" encoding="utf-8"?>
<!--
  Sonraki teslim widget'ı (2 × 1) — en küçük kutu.

  Üç satır sığabildiği için başlık ayrı bir satır kaplar: adı bilinen
  işin adı, altında ders ve kalan süre. Etiket sabittir ("Sonraki
  teslim"), böylece kullanıcı neye baktığını düşünmez.

  Sağdaki tamamla kutusu üç metnin **dışında**, kendi kasasındadır:
  sıradaki işi bitirmek bu widget'ın asıl eylemidir ve kutu ayrı
  seçilir ki tıklama metinlere dokunmayı (detayı açmayı) ezmesin.
  Kutu `gone` başlar; bekleyen ödev yokken görünmez, çünkü o zaman
  tamamlanacak bir şey de yoktur.

  Satırlar `gone` başlamaz; ilk açılışta bile anlamlı görünürler
  (`widget_sonraki_bos` gerçek bir cevaptır) ve kod yalnızca gerekirse
  değiştirir.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sonraki_kok"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_zemin"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="10dp"
    android:paddingEnd="14dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/sonraki_etiket"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_sonraki_etiket"
                android:textColor="@color/widget_vurgu"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/sonraki_baslik"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_sonraki_bos"
                android:textColor="@color/widget_metin"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/sonraki_alt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_ikincil"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/sonraki_isaret"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@null"
            android:contentDescription="@string/widget_tamamla"
            android:scaleType="centerInside"
            android:src="@drawable/widget_isaret"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
