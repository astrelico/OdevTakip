<?xml version="1.0" encoding="utf-8"?>
<!--
  Uygulama ikonunun zemini.

  Renk, "Odak Mavisi" paletinin kalbi olan primary (#2E5AAC) çevresinde
  kurulmuş kısa bir dikey tonlama: üstte bir tık açık, altta bir tık koyu.
  Düz bırakılmamasının iki nedeni var — ikon duvar kâğıdına göre her zaman
  aynı yeri kapladığı için tek renk olduğunda donmuş gibi duruyor; tonlama
  ise üstteki açık uç ile alttaki koyu ucu ayırarak kompozisyona yön veriyor.

  Şablon dosyadaki yeşil (#3DDC84) ve ızgara çizgileri bilinçle silindi:
  Android yeşili uygulamanın lacivert-mavi kimliğiyle çakışıyordu, ızgara
  ise ikon boyutuna inince okunmayan gürültüden başka bir şey değildi.

  Tümüyle native çizimdir; içe aktarılmış görsel yoktur.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="0"
                android:endY="108">
                <item android:color="#FF3A6BC0" android:offset="0.0" />
                <item android:color="#FF24478E" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
