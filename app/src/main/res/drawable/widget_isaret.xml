<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget satırındaki "tamamla" kutusunun çizimi.

  Uygulamadaki onay kutuları Compose olduğu için burada yeniden çizilir:
  widget'ı ana ekranı açan launcher şişirir, Compose'a erişemez.

  Şekil **boş bir halkadır**, işaretli bir kutu değil. Widget yalnızca
  tamamlanmamış ödevleri gösterir; dolu bir kutu çizmek "bu iş bitti"
  demek olurdu. Dokunulduğunda satır kendiliğinden kaybolur ve kaybolması
  dolu bir kutudan çok daha açıklayıcı bir geri bildirimdir.

  Elle çizildi: projeye dışarıdan ikon/dosya alınmaz.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="18dp"
    android:height="18dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Dört çeyrek yayla tam daire: dolgu yok, yalnızca kontur. -->
    <path
        android:pathData="M12,3 A9,9 0 0,1 21,12 A9,9 0 0,1 12,21 A9,9 0 0,1 3,12 A9,9 0 0,1 12,3 Z"
        android:fillColor="#00000000"
        android:strokeColor="@color/widget_vurgu"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="2.2" />
</vector>
