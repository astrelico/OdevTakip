<?xml version="1.0" encoding="utf-8"?>
<!--
  Kare biçimli başlatıcı ikonu (API 26+).

  `monochrome`, şablondan devralınırken ekran robotu başlığını gösteriyordu:
  Android 13'te temalı ikonu açan kullanıcı uygulama yerine bir Android
  robotu görüyordu. Artık ikonun kendi simgesini (onay işaretini) çiziyor.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
