<?xml version="1.0" encoding="utf-8"?>
<!--
  Sonraki teslim widget'ının tanımı (2 × 1) — dördünün en küçüğü.

  Tek satır yükseklik için 70dp: üç metin satırı (etiket, ad, ders +
  kalan süre) ancak bu yükseklikte dolmadan okunur. Daha küçük bir değer
  launcher tarafından iki satıra yuvarlanır ve kutu beklenenden uzun
  görünür.

  `updatePeriodMillis` = 0; bkz. odev_widget_bilgi.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_sonraki_aciklama"
    android:initialLayout="@layout/sonraki_widget"
    android:minWidth="110dp"
    android:minHeight="70dp"
    android:previewLayout="@layout/sonraki_widget"
    android:resizeMode="horizontal"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
