<?xml version="1.0" encoding="utf-8"?>
<!--
  Günün listesi widget'ının tanımı (4 × 4) — dördünün en büyüğü.

  250dp yerine 250dp yükseklik de istenir; launcher yatayda dört hücreye
  böldüğü için genişlik zaten özet widget'ı ile aynıdır, fark yalnızca
  yüksekliktir: altı satır ve "+N daha" satırı ancak iki kat alanda
  rahatça okunur.

  `updatePeriodMillis` = 0; bkz. odev_widget_bilgi.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_liste_aciklama"
    android:initialLayout="@layout/liste_widget"
    android:minWidth="250dp"
    android:minHeight="250dp"
    android:previewLayout="@layout/liste_widget"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
