<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Android 13+ (API 33) çalışma izni. Eklenmezse bildirimler sessizce
         yoksayılır. Uygulama ilk ödev kaydında isteyecek. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".OdevTakipApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.OdevTakip2">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.OdevTakip2">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Tarih/saat/saat dilimi değişince durum senkronunu tetikler.
            Üç aksiyon da Android'in korumalı yayınlarıdır; yalnızca sistem
            gönderebilir, bu yüzden dışarı açık olmak güvenlik açığı yaratmaz.
            Yine de periyodik WorkManager işi emniyet ağı olarak duruyor.
        -->
        <receiver
            android:name=".work.TarihDegisimAlcisi"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!--
            Bildirimdeki "Tamamla" düğmesini karşılar ve ödevi arka planda
            tamamlayıp o bildirimi kaldırır.

            exported="false" güvenlik sınırıdır: niyet yalnızca bu
            uygulamanın kendi bildiriminden (PendingIntent.getBroadcast)
            gelebilir, üçüncü bir uygulama ödevi kendi isteğiyle
            tamamlayamaz. Buna rağmen manifest'te listelenmek zorundadır —
            listelenmemiş bir alıcı hiçbir zaman oluşturulmaz.
        -->
        <receiver
            android:name=".bildirim.HizliTamamlaAlcisi"
            android:exported="false" />

        <!--
            Ana ekran widget'larının dördü de aynı kalıpı paylaşır:
            ayrı bir alıcı, kendi intent-filter'ı ve kendi
            xml/*_widget_bilgi tanımı. Android bir widget'ı meta-data ile
            tanım gösteren ALICI BİLEŞENİyle tanımlar; aynı sınıf iki kez
            bildirilemez ve iki farklı tanımı birden taşıyamaz — farklı
            boylar ve amaçlar için ayrı alıcılar zorunludur.

            exported="false" üçüncü bir uygulamanın bu alıcıları kendi
            niyetiyle çağırmasını engeller, sistem yayını ise yine de
            ulaşır — APPWIDGET_UPDATE Android'in korumalı yayınlarındandır
            ve yalnızca sistem gönderir. intent-filter olmadan widget
            tanınmaz; meta-data ise boyut, yenileme ve önizleme
            ayarlarını taşır.

            Etiketler bilinçli olarak ayrıdır: seçicide dört satır
            görünür ve hangisinin ne işe yaradığı adından anlaşılır.
            Uygulama grubunun başlığı yine de Application etiketidir.
        -->
        <receiver
            android:name=".widget.OdevWidgetAlcisi"
            android:exported="false"
            android:label="@string/widget_ozet_etiket">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/odev_widget_bilgi" />
        </receiver>

        <receiver
            android:name=".widget.OdevSayacWidgetAlcisi"
            android:exported="false"
            android:label="@string/widget_sayac_etiket">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/sayac_widget_bilgi" />
        </receiver>

        <receiver
            android:name=".widget.OdevListeWidgetAlcisi"
            android:exported="false"
            android:label="@string/widget_liste_etiket">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/liste_widget_bilgi" />
        </receiver>

        <receiver
            android:name=".widget.OdevSonrakiWidgetAlcisi"
            android:exported="false"
            android:label="@string/widget_sonraki_etiket">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/sonraki_widget_bilgi" />
        </receiver>

    </application>

</manifest>
